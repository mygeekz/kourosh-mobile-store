# Example only. No real Kourosh production domain or credentials.
NODE_ENV=production
KOUROSH_CLOUD_RUNTIME_DIR=/var/lib/kourosh-cloud
KOUROSH_CLOUD_CONTROL_DB_PATH=/var/lib/kourosh-cloud/control.db
KOUROSH_CLOUD_BACKUP_DIR=/var/lib/kourosh-cloud/backups
KOUROSH_CLOUD_PUBLIC_BASE_DOMAIN=example.invalid
KOUROSH_CLOUD_CONTROL_HOST=control.example.invalid
KOUROSH_CLOUD_CONNECTOR_HOST=connector.example.invalid
KOUROSH_CLOUD_INSTANCE_COUNT=1
KOUROSH_CLOUD_EDGE_CLIENT_IP_MODE=direct
KOUROSH_CLOUD_BACKUP_RETENTION=7
KOUROSH_CLOUD_RELAY_BIND_HOST=127.0.0.1
KOUROSH_CLOUD_RELAY_PORT=8787
KOUROSH_CLOUD_CONNECTOR_PUBLIC_ENDPOINT=wss://connector.example.invalid/connector
KOUROSH_CLOUD_DEV_AUTO_INIT=0
