{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 13I guarded metadata-only migration runner dry-run report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "dryRunKind",
    "status",
    "sourcePhase",
    "sourceMigrationDraftKind",
    "dryRunMode",
    "migrationRunnerDryRunOnly",
    "migrationRunnerRegistered",
    "migrationRunnerOperational",
    "sqlTextLoadedFromDisk",
    "sqlExecutionAllowed",
    "databaseConnectionAllowed",
    "databaseWriteAllowed",
    "migrationApplicationAllowed",
    "tableCreationApplied",
    "routeExposed",
    "plannedColumnCount",
    "plannedIndexCount",
    "plannedUniqueConstraintCount",
    "plannedCheckConstraintCount",
    "preflightCheckCount",
    "warningCount",
    "errorCount",
    "warnings",
    "errors",
    "preflightChecks",
    "plan",
    "sourceMigrationDraftReport",
    "migrationRunnerBoundary",
    "safetyPolicy",
    "generatedAt"
  ],
  "properties": {
    "phase": { "const": "Phase 13I" },
    "dryRunKind": { "const": "guarded_metadata_only_migration_runner_dry_run" },
    "status": { "enum": ["pass", "warning", "fail"] },
    "sourcePhase": { "const": "Phase 13H" },
    "sourceMigrationDraftKind": { "const": "metadata_only_shadow_score_storage_migration_draft" },
    "dryRunMode": { "const": "preflight_only_no_sql_execution" },
    "migrationRunnerDryRunOnly": { "const": true },
    "migrationRunnerRegistered": { "const": false },
    "migrationRunnerOperational": { "const": false },
    "sqlTextLoadedFromDisk": { "const": false },
    "sqlExecutionAllowed": { "const": false },
    "databaseConnectionAllowed": { "const": false },
    "databaseWriteAllowed": { "const": false },
    "migrationApplicationAllowed": { "const": false },
    "tableCreationApplied": { "const": false },
    "routeExposed": { "const": false },
    "plannedColumnCount": { "type": "integer", "minimum": 0 },
    "plannedIndexCount": { "type": "integer", "minimum": 0 },
    "plannedUniqueConstraintCount": { "type": "integer", "minimum": 0 },
    "plannedCheckConstraintCount": { "type": "integer", "minimum": 0 },
    "preflightCheckCount": { "type": "integer", "minimum": 0 },
    "warningCount": { "type": "integer", "minimum": 0 },
    "errorCount": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "preflightChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "message"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "warning", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "tableDraftName",
        "sourceMigrationDraftName",
        "sourceSqlDraftFile",
        "plannedColumns",
        "plannedIndexes",
        "plannedUniqueConstraints",
        "plannedCheckConstraintCount",
        "preflightOnly",
        "sqlTextLoadedFromDisk",
        "sqlExecutionAllowed",
        "databaseConnectionAllowed",
        "databaseWriteAllowed",
        "tableCreationApplied"
      ],
      "properties": {
        "tableDraftName": { "const": "shadow_score_metadata_only_store" },
        "sourceMigrationDraftName": { "const": "phase13h_shadow_score_metadata_only_store_draft" },
        "sourceSqlDraftFile": { "const": "server/intelligence/mlRuntime/migrationDrafts/phase13h_shadow_score_metadata_only_store.draft.sql" },
        "plannedColumns": { "type": "array" },
        "plannedIndexes": { "type": "array" },
        "plannedUniqueConstraints": { "type": "array", "items": { "type": "string" } },
        "plannedCheckConstraintCount": { "type": "integer", "minimum": 0 },
        "preflightOnly": { "const": true },
        "sqlTextLoadedFromDisk": { "const": false },
        "sqlExecutionAllowed": { "const": false },
        "databaseConnectionAllowed": { "const": false },
        "databaseWriteAllowed": { "const": false },
        "tableCreationApplied": { "const": false }
      }
    },
    "sourceMigrationDraftReport": { "type": "object" },
    "migrationRunnerBoundary": {
      "type": "object",
      "properties": {
        "migrationRunnerDryRunOnly": { "const": true },
        "preflightOnly": { "const": true },
        "sourceSqlFileIsNotReadFromDisk": { "const": true },
        "sqlTextLoadedFromDisk": { "const": false },
        "sqlFileIsNotExecuted": { "const": true },
        "sqlExecutionAllowed": { "const": false },
        "databaseConnectionAllowed": { "const": false },
        "databaseWriteAllowed": { "const": false },
        "migrationApplicationAllowed": { "const": false },
        "migrationRunnerRegistered": { "const": false },
        "migrationRunnerOperational": { "const": false },
        "migrationRegistryMutated": { "const": false },
        "tableCreationApplied": { "const": false },
        "tableCreated": { "const": false },
        "exposesRoute": { "const": false },
        "executesModel": { "const": false },
        "activatesArtifact": { "const": false },
        "mutatesBusinessRecords": { "const": false }
      }
    },
    "safetyPolicy": {
      "type": "object",
      "properties": {
        "migrationRunnerDryRunOnly": { "const": true },
        "preflightOnly": { "const": true },
        "noSqlFileRuntimeRead": { "const": true },
        "noRuntimeSqlExecution": { "const": true },
        "noDatabaseConnection": { "const": true },
        "noDatabaseWrite": { "const": true },
        "noTableCreated": { "const": true },
        "noMigrationRegistryMutation": { "const": true },
        "modelExecutionAllowed": { "const": false },
        "runtimeInvocationAllowed": { "const": false },
        "inferenceEndpointExposed": { "const": false },
        "artifactActivationAllowed": { "const": false },
        "canMutateBusinessRecords": { "const": false }
      }
    },
    "generatedAt": { "type": "string" }
  }
}
