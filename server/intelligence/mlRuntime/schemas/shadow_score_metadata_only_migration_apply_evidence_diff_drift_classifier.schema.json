{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kourosh.shadow_score_metadata_only_migration_apply_evidence_diff_drift_classifier.schema.json",
  "title": "Kourosh Phase 13R Metadata-only Migration Apply Evidence Diff Drift Classifier",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "phase",
    "classifierKind",
    "classifierMode",
    "driftClassifierOnly",
    "evidenceOnly",
    "deterministicRuleBasedOnly",
    "noMlClassifier",
    "allowed",
    "ready",
    "migrationApplicationAllowed",
    "sqlExecutionAllowed",
    "databaseConnectionAllowed",
    "databaseWriteAllowed",
    "tableCreated",
    "routeExposed",
    "driftRows",
    "safetyPolicy"
  ],
  "properties": {
    "phase": { "const": "Phase 13R" },
    "classifierKind": { "const": "metadata_only_migration_apply_evidence_diff_drift_classifier" },
    "sourcePhase": { "const": "Phase 13Q" },
    "sourceSnapshotKind": { "const": "metadata_only_migration_apply_evidence_diff_snapshot" },
    "classifierMode": { "const": "drift_classifier_only_no_migration_application" },
    "driftClassifierOnly": { "const": true },
    "evidenceOnly": { "const": true },
    "deterministicRuleBasedOnly": { "const": true },
    "noMlClassifier": { "const": true },
    "unsafeDriftDetected": { "const": false },
    "operatorApproved": { "const": false },
    "allowed": { "const": false },
    "ready": { "const": false },
    "migrationApplyAccepted": { "const": false },
    "migrationApplicationAllowed": { "const": false },
    "migrationApplicationPerformed": { "const": false },
    "migrationRunnerRegistered": { "const": false },
    "migrationRunnerOperational": { "const": false },
    "migrationRegistryMutated": { "const": false },
    "sqlTextLoadedFromDisk": { "const": false },
    "sqlExecutionAllowed": { "const": false },
    "databaseConnectionAllowed": { "const": false },
    "databaseWriteAllowed": { "const": false },
    "tableCreationApplied": { "const": false },
    "tableCreated": { "const": false },
    "repositoryWriteAllowed": { "const": false },
    "routeExposed": { "const": false },
    "sourceDiffRowCount": { "const": 17 },
    "classifiedRowCount": { "const": 17 },
    "safeNoopDriftCount": { "const": 17 },
    "blockedPolicyDriftCount": { "const": 0 },
    "unsafeBoundaryDriftCount": { "const": 0 },
    "safetyRelevantDriftCount": { "const": 0 },
    "blockedInvariantPreserved": { "const": true },
    "driftRows": {
      "type": "array",
      "minItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["field", "sourceDiffStatus", "driftClass", "driftSeverity", "actionable", "migrationApplicationAllowed"],
        "properties": {
          "sourceDiffStatus": { "const": "unchanged_blocked" },
          "driftClass": { "enum": ["safe_noop_drift", "blocked_policy_drift", "unsafe_boundary_drift"] },
          "driftSeverity": { "enum": ["none", "medium", "critical"] },
          "actionable": { "const": false },
          "operatorApproved": { "const": false },
          "allowed": { "const": false },
          "ready": { "const": false },
          "migrationApplicationAllowed": { "const": false },
          "sqlExecutionAllowed": { "const": false },
          "databaseConnectionAllowed": { "const": false },
          "databaseWriteAllowed": { "const": false },
          "routeExposed": { "const": false },
          "businessMutationAllowed": { "const": false }
        }
      }
    },
    "safetyPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "phase": { "const": "Phase 13R" },
        "driftClassifierOnly": { "const": true },
        "noMlClassifier": { "const": true },
        "noRuntimeSqlExecution": { "const": true },
        "noDatabaseConnection": { "const": true },
        "noDatabaseWrite": { "const": true },
        "modelExecutionAllowed": { "const": false },
        "inferenceEndpointExposed": { "const": false },
        "artifactActivationAllowed": { "const": false },
        "canMutateBusinessRecords": { "const": false }
      }
    }
  }
}
