        "additionalProperties": true,
        "required": [
          "scenarioId",
          "scenarioKind",
          "expectedOutcome",
          "scenarioStatus",
          "expectedMigrationApplicationAllowed",
          "actualMigrationApplicationAllowed",
          "actualSqlExecutionAllowed",
          "actualDatabaseWriteAllowed",
          "actualRouteExposed",
          "actualBusinessMutationAllowed",
          "regressionAccepted",
          "regressionApplied",
          "evidenceOnly",
          "metadataOnly"
        ],
