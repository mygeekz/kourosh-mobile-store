    "safetyPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "regressionFixtureOnly": { "const": true },
        "noMlClassifier": { "const": true },
        "noRuntimeSqlExecution": { "const": true },
        "noDatabaseConnection": { "const": true },
