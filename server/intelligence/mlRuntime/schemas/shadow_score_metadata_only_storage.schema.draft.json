{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kourosh.phase13f.shadow_score_metadata_only_storage.schema.draft.json",
  "title": "Phase 13F metadata-only shadow score storage schema draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storageRecordId",
    "importRecordId",
    "shadowScoreId",
    "entityType",
    "entityId",
    "predictionType",
    "horizonDays",
    "candidateScore",
    "candidateLabel",
    "candidateConfidence",
    "scoreQuality",
    "modelKey",
    "modelVersion",
    "candidatePackageId",
    "sourceImportFixtureId",
    "sourceShadowExportId",
    "sourceExportRecordHash",
    "scoreGeneratedAt",
    "exportGeneratedAt",
    "importFixtureGeneratedAt",
    "metadataFingerprint",
    "idempotencyKey",
    "storageClass",
    "storageMode",
    "evidenceOnly",
    "metadataOnly",
    "schemaDraftOnly",
    "repositoryWriteMethodAvailable",
    "databaseWriteAllowed",
    "routeExposed",
    "modelExecutionAllowed",
    "inferenceEndpointExposed",
    "artifactActivationAllowed",
    "businessMutationAllowed"
  ],
  "properties": {
    "storageRecordId": { "type": "string", "minLength": 1 },
    "importRecordId": { "type": "string", "minLength": 1 },
    "shadowScoreId": { "type": "string", "minLength": 1 },
    "entityType": { "type": "string", "minLength": 1 },
    "entityId": { "type": "string", "minLength": 1 },
    "predictionType": { "type": "string", "minLength": 1 },
    "horizonDays": { "type": ["integer", "null"], "minimum": 1 },
    "candidateScore": { "type": ["number", "null"] },
    "candidateLabel": { "type": "string", "minLength": 1 },
    "candidateConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "scoreQuality": { "type": "string", "minLength": 1 },
    "modelKey": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "candidatePackageId": { "type": "string", "minLength": 1 },
    "sourceImportFixtureId": { "type": "string", "minLength": 1 },
    "sourceShadowExportId": { "type": "string", "minLength": 1 },
    "sourceExportRecordHash": { "type": "string", "minLength": 1 },
    "scoreGeneratedAt": { "type": "string", "minLength": 1 },
    "exportGeneratedAt": { "type": "string", "minLength": 1 },
    "importFixtureGeneratedAt": { "type": "string", "minLength": 1 },
    "metadataFingerprint": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "storageClass": { "const": "metadata_only_shadow_score_storage_schema_draft" },
    "storageMode": { "const": "schema_draft_no_write" },
    "evidenceOnly": { "const": true },
    "metadataOnly": { "const": true },
    "schemaDraftOnly": { "const": true },
    "repositoryWriteMethodAvailable": { "const": false },
    "databaseWriteAllowed": { "const": false },
    "routeExposed": { "const": false },
    "modelExecutionAllowed": { "const": false },
    "inferenceEndpointExposed": { "const": false },
    "artifactActivationAllowed": { "const": false },
    "businessMutationAllowed": { "const": false }
  }
}
