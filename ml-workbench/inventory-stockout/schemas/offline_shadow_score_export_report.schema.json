{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kourosh.local/schemas/phase13b/offline_shadow_score_export_report.schema.json",
  "title": "Kourosh Phase 13B Offline Shadow Score Export Report",
  "type": "object",
  "required": [
    "contractVersion",
    "candidatePackageId",
    "modelKey",
    "modelVersion",
    "predictionType",
    "exportStatus",
    "validationStatus",
    "rowCount",
    "recordCount",
    "scoreDistribution",
    "confidenceSummary",
    "labelDistribution",
    "scoreQualityDistribution",
    "outputReferences",
    "warnings",
    "errors",
    "safetyPolicy",
    "generatedAt",
    "evidenceOnly",
    "productionReadinessClaim",
    "backendInferenceClaim",
    "artifactActivationClaim",
    "businessMutationClaim",
    "scopeLimitations"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": "phase13b-v1" },
    "candidatePackageId": { "type": ["string", "null"] },
    "modelKey": { "type": ["string", "null"] },
    "modelVersion": { "type": ["string", "null"] },
    "predictionType": { "type": ["string", "null"] },
    "exportStatus": {
      "enum": [
        "offline_shadow_score_export_validated",
        "offline_shadow_score_export_with_warnings",
        "offline_shadow_score_export_invalid"
      ]
    },
    "validationStatus": { "enum": ["pass", "warning", "fail", "unknown"] },
    "rowCount": { "type": ["integer", "null"], "minimum": 0 },
    "recordCount": { "type": ["integer", "null"], "minimum": 0 },
    "scoreDistribution": { "type": "object" },
    "confidenceSummary": { "type": "object" },
    "labelDistribution": { "type": "object" },
    "scoreQualityDistribution": { "type": "object" },
    "outputReferences": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "safetyPolicy": {
      "type": "object",
      "properties": {
        "modelExecutionAllowed": { "const": false },
        "runtimeInvocationAllowed": { "const": false },
        "inferenceEndpointExposed": { "const": false },
        "productionIntegrationAllowed": { "const": false },
        "decisionAutomationAllowed": { "const": false },
        "canChangeInventoryOrAccounting": { "const": false },
        "canChangePricing": { "const": false },
        "canChangeReports": { "const": false },
        "canChangeLedger": { "const": false },
        "canMutateBusinessRecords": { "const": false },
        "artifactExecutionAllowed": { "const": false },
        "artifactActivationAllowed": { "const": false },
        "artifactBytesLoadingAllowed": { "const": false },
        "rawTrainingCsvLoadingAllowed": { "const": false },
        "automaticDeletionAllowed": { "const": false },
        "purgeJobAllowed": { "const": false },
        "backendMayExecuteModel": { "const": false },
        "backendMayCallInferenceRuntime": { "const": false },
        "backendMayMutateBusinessRecords": { "const": false }
      }
    },
    "generatedAt": { "type": "string" },
    "evidenceOnly": { "const": true },
    "productionReadinessClaim": { "const": "not_approved_for_production" },
    "backendInferenceClaim": { "const": "not_exposed" },
    "artifactActivationClaim": { "const": "not_activated" },
    "businessMutationClaim": { "const": "not_allowed" },
    "scopeLimitations": { "type": "array", "items": { "type": "string" } }
  }
}
