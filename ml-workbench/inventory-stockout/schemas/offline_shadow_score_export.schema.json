{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kourosh.local/schemas/phase13b/offline_shadow_score_export.schema.json",
  "title": "Kourosh Phase 13B Offline Shadow Score Metadata Export",
  "type": "object",
  "required": [
    "contractVersion",
    "exportKind",
    "candidatePackageId",
    "modelKey",
    "modelVersion",
    "predictionType",
    "horizonDays",
    "generatedAt",
    "workbenchVersion",
    "source",
    "backendImportPolicy",
    "safetyPolicy",
    "summary",
    "recordCount",
    "records",
    "warnings",
    "errors",
    "evidenceOnly",
    "productionReadinessClaim",
    "backendInferenceClaim",
    "artifactActivationClaim",
    "businessMutationClaim"
  ],
  "additionalProperties": false,
  "properties": {
    "contractVersion": { "const": "phase13b-v1" },
    "exportKind": { "const": "offline_shadow_score_metadata_export" },
    "candidatePackageId": { "type": "string", "minLength": 1 },
    "modelKey": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "predictionType": { "type": "string", "minLength": 1 },
    "horizonDays": { "type": ["integer", "null"] },
    "generatedAt": { "type": "string", "minLength": 1 },
    "workbenchVersion": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": [
        "scoreOutputPath",
        "scoreOutputSha256",
        "scoreOutputGeneratedAt",
        "scoreValidationReportPath",
        "scoreValidationReportSha256",
        "scoreValidationStatus",
        "offlineExecutionReportPath",
        "offlineExecutionReportSha256",
        "offlineExecutionStatus",
        "rowCount",
        "scoreCount"
      ],
      "additionalProperties": false,
      "properties": {
        "scoreOutputPath": { "type": "string" },
        "scoreOutputSha256": { "type": "string" },
        "scoreOutputGeneratedAt": { "type": ["string", "null"] },
        "scoreValidationReportPath": { "type": "string" },
        "scoreValidationReportSha256": { "type": "string" },
        "scoreValidationStatus": { "enum": ["pass", "warning"] },
        "offlineExecutionReportPath": { "type": "string" },
        "offlineExecutionReportSha256": { "type": ["string", "null"] },
        "offlineExecutionStatus": {
          "enum": [
            "offline_execution_validated",
            "offline_execution_with_warnings",
            "offline_execution_invalid",
            "unknown"
          ]
        },
        "rowCount": { "type": "integer", "minimum": 0 },
        "scoreCount": { "type": "integer", "minimum": 0 }
      }
    },
    "backendImportPolicy": {
      "type": "object",
      "required": [
        "contractPurpose",
        "backendAcceptableAsMetadataOnly",
        "backendMustNotLoadModelArtifact",
        "backendMustNotExecuteModel",
        "backendMustNotExposeInference",
        "backendMustNotActivateArtifact",
        "backendMustNotMutateBusinessRecords",
        "backendMustTreatAsEvidenceOnly"
      ],
      "additionalProperties": false,
      "properties": {
        "contractPurpose": { "const": "metadata_only_shadow_score_export" },
        "backendAcceptableAsMetadataOnly": { "const": true },
        "backendMustNotLoadModelArtifact": { "const": true },
        "backendMustNotExecuteModel": { "const": true },
        "backendMustNotExposeInference": { "const": true },
        "backendMustNotActivateArtifact": { "const": true },
        "backendMustNotMutateBusinessRecords": { "const": true },
        "backendMustTreatAsEvidenceOnly": { "const": true }
      }
    },
    "safetyPolicy": {
      "type": "object",
      "properties": {
        "modelExecutionAllowed": { "const": false },
        "runtimeInvocationAllowed": { "const": false },
        "inferenceEndpointExposed": { "const": false },
        "productionIntegrationAllowed": { "const": false },
        "decisionAutomationAllowed": { "const": false },
        "canChangeInventoryOrAccounting": { "const": false },
        "canChangePricing": { "const": false },
        "canChangeReports": { "const": false },
        "canChangeLedger": { "const": false },
        "canMutateBusinessRecords": { "const": false },
        "artifactExecutionAllowed": { "const": false },
        "artifactActivationAllowed": { "const": false },
        "artifactBytesLoadingAllowed": { "const": false },
        "rawTrainingCsvLoadingAllowed": { "const": false },
        "automaticDeletionAllowed": { "const": false },
        "purgeJobAllowed": { "const": false },
        "backendMayExecuteModel": { "const": false },
        "backendMayCallInferenceRuntime": { "const": false },
        "backendMayMutateBusinessRecords": { "const": false }
      }
    },
    "summary": { "type": "object" },
    "recordCount": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "shadowScoreId",
          "entityType",
          "entityId",
          "predictionType",
          "horizonDays",
          "candidateScore",
          "candidateLabel",
          "candidateConfidence",
          "scoreQuality",
          "modelKey",
          "modelVersion",
          "candidatePackageId",
          "sourceRowIndex",
          "scoreGeneratedAt",
          "exportGeneratedAt",
          "storageClass",
          "evidenceOnly",
          "backendAction",
          "automationAllowed",
          "businessMutationAllowed",
          "inventoryMutationAllowed",
          "accountingMutationAllowed",
          "pricingMutationAllowed",
          "ledgerMutationAllowed",
          "reportMutationAllowed",
          "artifactActivationAllowed",
          "modelExecutionAllowed",
          "inferenceEndpointExposed",
          "safetyNotes"
        ],
        "additionalProperties": false,
        "properties": {
          "shadowScoreId": { "type": "string", "minLength": 1 },
          "entityType": { "type": "string", "minLength": 1 },
          "entityId": { "type": "string", "minLength": 1 },
          "predictionType": { "type": "string", "minLength": 1 },
          "horizonDays": { "type": ["integer", "null"] },
          "candidateScore": { "type": ["number", "null"] },
          "candidateLabel": { "type": "string" },
          "candidateConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "scoreQuality": { "enum": ["high", "medium", "low", "score_unavailable"] },
          "modelKey": { "type": "string" },
          "modelVersion": { "type": "string" },
          "candidatePackageId": { "type": "string" },
          "sourceRowIndex": { "type": "integer", "minimum": 0 },
          "scoreGeneratedAt": { "type": "string" },
          "exportGeneratedAt": { "type": "string" },
          "storageClass": { "const": "metadata_only_shadow_score" },
          "evidenceOnly": { "const": true },
          "backendAction": { "const": "none" },
          "automationAllowed": { "const": false },
          "businessMutationAllowed": { "const": false },
          "inventoryMutationAllowed": { "const": false },
          "accountingMutationAllowed": { "const": false },
          "pricingMutationAllowed": { "const": false },
          "ledgerMutationAllowed": { "const": false },
          "reportMutationAllowed": { "const": false },
          "artifactActivationAllowed": { "const": false },
          "modelExecutionAllowed": { "const": false },
          "inferenceEndpointExposed": { "const": false },
          "safetyNotes": { "type": "array", "items": { "type": "string" } }
        },
        "not": {
          "anyOf": [
            { "required": ["set_stock"] },
            { "required": ["change_price"] },
            { "required": ["approve_purchase"] },
            { "required": ["create_invoice"] },
            { "required": ["mutate_ledger"] },
            { "required": ["auto_order"] },
            { "required": ["delete_record"] },
            { "required": ["production_action"] },
            { "required": ["auto_decision"] },
            { "required": ["activate_artifact"] },
            { "required": ["deploy_model"] },
            { "required": ["write_inventory"] },
            { "required": ["write_accounting"] },
            { "required": ["write_ledger"] },
            { "required": ["write_report"] },
            { "required": ["activationDirective"] },
            { "required": ["productionDecisionDirective"] },
            { "required": ["backendExecutionDirective"] }
          ]
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "evidenceOnly": { "const": true },
    "productionReadinessClaim": { "const": "not_approved_for_production" },
    "backendInferenceClaim": { "const": "not_exposed" },
    "artifactActivationClaim": { "const": "not_activated" },
    "businessMutationClaim": { "const": "not_allowed" }
  }
}
